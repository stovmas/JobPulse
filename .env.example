# Supabase (get these from your Supabase project dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# EmailJS (set these as Vercel Environment Variables, not in .env)
# These are used by the server-side email API (api/send-email.js)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=user_xxxxxxxxxxxx

# Supabase Service Role Key (for server-side cron job to read all users' settings)
# Get from Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cron Secret (Vercel uses this to authenticate cron requests)
# Get from Vercel dashboard → Settings → Environment Variables → CRON_SECRET
# Vercel auto-generates this when you add a cron job
CRON_SECRET=your-cron-secret-here
